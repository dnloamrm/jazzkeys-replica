{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/_nuxt/(.*)",
      "dest": "/_nuxt/$1"
    },
    {
      "src": "/midifiles/(.*)",
      "dest": "/midifiles/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Content-Type": "audio/midi",
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
